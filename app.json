{
  "expo": {
    "name": "Whiteswan TV News",
    "slug": "whiteswan-tv-news",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whiteswantv.news",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "ppe",
          "tez",
          "paytmmp",
          "upi",
          "whatsapp",
          "bhim",
          "credpay",
          "amazonpay",
          "supermoney"
        ]
      }
    },
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#00A3E8"
    },
    "scheme": "whiteswantv",
    "android": {
      "package": "com.whiteswantv.news",
      "versionCode": 25,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "whiteswantvnews.com"
            },
            {
              "scheme": "https",
              "host": "www.whiteswantvnews.com"
            },
            {
              "scheme": "http",
              "host": "whiteswantvnews.com"
            },
            {
              "scheme": "http",
              "host": "www.whiteswantvnews.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "whiteswantv"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "upi"
            },
            {
              "scheme": "phonepe"
            },
            {
              "scheme": "ppe"
            },
            {
              "scheme": "tez"
            },
            {
              "scheme": "paytmmp"
            },
            {
              "scheme": "bhim"
            },
            {
              "scheme": "credpay"
            },
            {
              "scheme": "amazonpay"
            },
            {
              "scheme": "supermoney"
            },
            {
              "scheme": "gpay"
            },
            {
              "scheme": "paytm"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": [
            "./assets/notification_icon.png"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "geomanu",
    "extra": {
      "eas": {
        "projectId": "ff4e4a8e-ebce-48d6-8aef-058ed01e5cec"
      }
    }
  }
}
