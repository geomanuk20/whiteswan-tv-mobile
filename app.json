{
  "expo": {
    "name": "Whiteswan TV News",
    "slug": "whiteswan",
    "version": "1.0.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#022A62"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whiteswantv.news",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "ppe",
          "tez",
          "paytmmp",
          "upi",
          "whatsapp",
          "bhim",
          "credpay",
          "amazonpay",
          "supermoney"
        ]
      }
    },
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#00A3E8"
    },
    "scheme": "whiteswantv",
    "android": {
      "package": "com.whiteswantv.news",
      "versionCode": 27,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#022A62"
      },
      "adaptiveIcon": {
        "backgroundColor": "#022A62",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "whiteswantvnews.com"
            },
            {
              "scheme": "https",
              "host": "www.whiteswantvnews.com"
            },
            {
              "scheme": "http",
              "host": "whiteswantvnews.com"
            },
            {
              "scheme": "http",
              "host": "www.whiteswantvnews.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "whiteswantv"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "upi"
            },
            {
              "scheme": "phonepe"
            },
            {
              "scheme": "ppe"
            },
            {
              "scheme": "tez"
            },
            {
              "scheme": "paytmmp"
            },
            {
              "scheme": "bhim"
            },
            {
              "scheme": "credpay"
            },
            {
              "scheme": "amazonpay"
            },
            {
              "scheme": "supermoney"
            },
            {
              "scheme": "gpay"
            },
            {
              "scheme": "paytm"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#022A62",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#022A62"
          },
          "imageWidth": 200
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": [
            "./assets/notification_icon.png"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "owner": "technical-49s-team",
    "extra": {
      "eas": {
        "projectId": "a8498d74-2b85-40c5-add5-0a84577576df"
      }
    }
  }
}
