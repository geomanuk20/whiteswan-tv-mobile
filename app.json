{
  "expo": {
    "name": "Whiteswan TV News",
    "slug": "whiteswan-tv-news",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whiteswantv.news",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "ppe",
          "tez",
          "paytmmp",
          "upi",
          "whatsapp",
          "bhim",
          "credpay",
          "amazonpay",
          "supermoney"
        ]
      }
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#00A3E8"
    },
    "android": {
      "package": "com.whiteswantv.news",
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "upi"
            },
            {
              "scheme": "phonepe"
            },
            {
              "scheme": "ppe"
            },
            {
              "scheme": "tez"
            },
            {
              "scheme": "paytmmp"
            },
            {
              "scheme": "bhim"
            },
            {
              "scheme": "credpay"
            },
            {
              "scheme": "amazonpay"
            },
            {
              "scheme": "supermoney"
            },
            {
              "scheme": "gpay"
            },
            {
              "scheme": "paytm"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": [
            "./assets/notification-icon.png"
          ]
        }
      ]
    ],
    "owner": "geomanu",
    "extra": {
      "eas": {
        "projectId": "ff4e4a8e-ebce-48d6-8aef-058ed01e5cec"
      }
    }
  }
}
